# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# SET HIGHER MINIMUM IOS VERSION (iOS 14.0 or higher)
min_ios_version_supported = '18.0'  # Changed from 13.0 to 14.0
platform :ios, min_ios_version_supported

prepare_react_native_project!

# Framework linking configuration
linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
else
  # Default to static linking for better performance
  use_frameworks! :linkage => :static
end

target 'Muzive' do
  config = use_native_modules!
  
  # ========== FIREBASE PODS ==========
  # Use Firebase BoM for version consistency (latest stable version)
  # pod 'Firebase', '~> 10.23.0'  # Updated to latest version
  
  # Individual Firebase services
  pod 'Firebase/Auth', '12.8.0'
  pod 'Firebase/Firestore', '12.8.0'
  pod 'Firebase/Functions', '12.8.0'
  
  # React Native Firebase pods with specific versions
  pod 'RNFBApp', :path => '../node_modules/@react-native-firebase/app'
  pod 'RNFBAuth', :path => '../node_modules/@react-native-firebase/auth'
  pod 'RNFBFirestore', :path => '../node_modules/@react-native-firebase/firestore'
  pod 'RNFBFunctions', :path => '../node_modules/@react-native-firebase/functions'
  
  # ========== REACT NATIVE ==========
  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :hermes_enabled => true
  )
  
  # ========== POST INSTALL SCRIPT ==========
  post_install do |installer|
    # React Native post install
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )
    
    # Set deployment target for ALL pods
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # Set minimum deployment target
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
        
        # Fix bitcode issues
        config.build_settings['ENABLE_BITCODE'] = 'NO'
        
        # Fix arm64 simulator issues on M1/M2 Macs
        config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
        
        # Enable modular headers for Firebase
        if target.name.include?('Firebase') || target.name.include?('Google') || target.name.include?('RNFB')
          config.build_settings['DEFINES_MODULE'] = 'YES'
        end
      end
    end
    
    # Project level settings
    installer.pods_project.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
      config.build_settings['LD_RUNPATH_SEARCH_PATHS'] = [
        '$(FRAMEWORK_SEARCH_PATHS)',
        '$(inherited)',
        '@executable_path/Frameworks'
      ]
    end
  end
end